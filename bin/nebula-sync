#!/usr/bin/env bash
# nebula-sync - Pone al dia la sesion Nebula. Corre en cada login (lo lanza
# bspwmrc, en segundo plano, una vez por sesion) y tambien a mano.
#
#   1. Detecta si los dotfiles del repo cambiaron desde el ultimo despliegue
#   2. Detecta paquetes de PKGS_BASE que falten
#   3. Por defecto SOLO AVISA (notify-send) con el comando para aplicarlo.
#
# Aplicar cambios es opt-in (docs/ROADMAP-REPARACION.md D6 / BUG-007): antes
# redesplegaba dotfiles e instalaba paquetes en cada login sin preguntar.
#   nebula-sync --apply                      aplica ahora (a mano)
#   touch ~/.config/nebula-session/auto-sync aplica solo en cada login
# El redespliegue respeta tus ediciones (quedan .nebula-new, ver 30-dotfiles).
# Instalar paquetes requiere una via de root sin prompt (`sudo -n` o pkexec
# con agente polkit); ~/.config/nebula/no-auto-pkgs lo sigue desactivando.
#
# NUNCA bloquea la sesion: sin red / apt ocupado / sin root -> avisa, sale 0.
#
# Uso: nebula-sync [--apply] [--quiet] [--once] [--dotfiles-only] [--pkgs-only] [--help]
set -uo pipefail

QUIET=0 ONCE=0 DO_DOTS=1 DO_PKGS=1 APPLY=0
for a in "$@"; do
    case "$a" in
        --apply)         APPLY=1 ;;
        --quiet)         QUIET=1 ;;
        --once)          ONCE=1 ;;
        --dotfiles-only) DO_PKGS=0 ;;
        --pkgs-only)     DO_DOTS=0 ;;
        -h|--help)       sed -n '2,20p' "$0"; exit 0 ;;
        *)               echo "nebula-sync: opcion desconocida: $a" >&2; exit 2 ;;
    esac
done

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"

# Helpers de runtime compartidos (nebula_reload_sxhkd): deploy o repo.
for _c in "${XDG_DATA_HOME:-$HOME/.local/share}/nebula/lib/nebula-runtime.sh" \
          "$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" 2>/dev/null && pwd)/nebula-runtime.sh"; do
    # shellcheck disable=SC1090  # ruta resuelta en runtime (deploy vs repo)
    [[ -n "$_c" && -f "$_c" ]] && { source "$_c"; break; }
done
unset _c
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/nebula"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}/nebula"
mkdir -p "$DATA" "$RUNTIME" 2>/dev/null || true
[[ -e "${XDG_CONFIG_HOME:-$HOME/.config}/nebula-session/auto-sync" ]] && APPLY=1

note() { [[ "$QUIET" -eq 1 ]] && return 0; command -v notify-send >/dev/null 2>&1 && notify-send -a "Nebula" "$1" "${2:-}" || echo "[nebula-sync] $1 ${2:-}"; }
# Avisos de "hay algo pendiente": salen aunque sea --quiet (es su razon de ser).
tell() { command -v notify-send >/dev/null 2>&1 && notify-send -a "Nebula" "$1" "${2:-}" || echo "[nebula-sync] $1 ${2:-}"; }
warn() { command -v notify-send >/dev/null 2>&1 && notify-send -a "Nebula" -u critical "$1" "${2:-}" || echo "[nebula-sync] $1 ${2:-}" >&2; }

# --- guard: una vez por sesion (--once) ----------------------------------
if [[ "$ONCE" -eq 1 ]]; then
    marker="$RUNTIME/sync.done"
    [[ -e "$marker" ]] && exit 0
    : > "$marker"
fi

# --- ubicacion del repo ------------------------------------------------
REPO=""
[[ -r "$DATA/repo-path" ]] && REPO="$(cat "$DATA/repo-path")"
[[ -n "$REPO" && -f "$REPO/install/10-base.sh" ]] || REPO=""

# ---------------------------------------------------------------------------
# 1. Dotfiles: redesplegar solo si el arbol dotfiles/ del repo cambio.
# ---------------------------------------------------------------------------
if [[ "$DO_DOTS" -eq 1 && -n "$REPO" && $EUID -ne 0 ]]; then
    cur="$(find "$REPO/dotfiles" -type f -exec sha256sum {} + 2>/dev/null | sort | sha256sum | cut -d' ' -f1)"
    old=""; [[ -r "$DATA/dotfiles.hash" ]] && old="$(cat "$DATA/dotfiles.hash")"
    if [[ -n "$cur" && "$cur" != "$old" && "$APPLY" -eq 0 ]]; then
        tell "Nebula: hay cambios en los dotfiles del repo" "Aplicalos con: nebula-sync --apply --dotfiles-only"
    elif [[ -n "$cur" && "$cur" != "$old" ]]; then
        note "Sincronizando" "dotfiles del repo cambiaron: redesplegando a ~/.config"
        if NEBULA_LINK="${NEBULA_LINK:-copy}" NEBULA_DRY_RUN=0 bash "$REPO/install/30-dotfiles.sh" >/dev/null 2>&1; then
            # (30-dotfiles.sh ya escribe dotfiles.hash con la misma formula.)
            command -v bspc >/dev/null 2>&1 && bspc wm -r >/dev/null 2>&1 || true
            if command -v nebula_reload_sxhkd >/dev/null 2>&1; then
                nebula_reload_sxhkd
            else
                pkill -USR1 -x sxhkd >/dev/null 2>&1 || true
            fi
            note "Dotfiles al dia" "recargado bspwm/sxhkd"
        else
            warn "nebula-sync" "fallo el redespliegue de dotfiles (30-dotfiles.sh)"
        fi
    fi
elif [[ "$DO_DOTS" -eq 1 && -z "$REPO" ]]; then
    [[ "$QUIET" -eq 1 ]] || note "nebula-sync" "no se donde esta el repo (falta $DATA/repo-path): omito el redespliegue de dotfiles"
fi

# ---------------------------------------------------------------------------
# 2. Paquetes: instalar los de PKGS_BASE que falten.
# ---------------------------------------------------------------------------
[[ "$DO_PKGS" -eq 1 ]] || exit 0

# Lista de paquetes: preferir el repo (mas fresco), si no la copia desplegada.
pkgs_raw=""
if [[ -n "$REPO" ]]; then
    pkgs_raw="$( eval "$(sed -n '/^PKGS_BASE=(/,/^)/p' "$REPO/install/10-base.sh")" 2>/dev/null; printf '%s\n' "${PKGS_BASE[@]:-}" )"
fi
[[ -z "${pkgs_raw// }" && -r "$DATA/pkgs.list" ]] && pkgs_raw="$(cat "$DATA/pkgs.list")"
mapfile -t want < <(printf '%s\n' "$pkgs_raw" | sed 's/#.*//' | tr -s ' ' '\n' | grep -E '^[a-z0-9][a-z0-9.+-]*$' | sort -u)
[[ "${#want[@]}" -gt 0 ]] || { [[ "$QUIET" -eq 1 ]] || note "nebula-sync" "no pude armar la lista de paquetes"; exit 0; }

missing=()
for p in "${want[@]}"; do
    dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'install ok installed' || missing+=("$p")
done
[[ "${#missing[@]}" -gt 0 ]] || exit 0

if [[ -e "$CFG/nebula/no-auto-pkgs" || "$APPLY" -eq 0 ]]; then
    warn "Nebula: faltan paquetes" "${missing[*]} — corre: sudo apt install -y ${missing[*]}"
    exit 0
fi

# apt ocupado?
if command -v fuser >/dev/null 2>&1 && fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1; then
    note "nebula-sync" "apt esta ocupado; reintento en el proximo login"
    exit 0
fi
# red?
if ! getent hosts archive.ubuntu.com >/dev/null 2>&1 && ! getent hosts deb.debian.org >/dev/null 2>&1; then
    note "nebula-sync" "sin red: no instalo paquetes ahora (${#missing[@]} pendientes)"
    exit 0
fi

# via de root
RUN=()
if [[ $EUID -eq 0 ]]; then
    RUN=(env)
elif sudo -n true 2>/dev/null; then
    RUN=(sudo -n env)
elif command -v pkexec >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]] && pgrep -x lxpolkit >/dev/null 2>&1; then
    RUN=(pkexec env)
else
    warn "Nebula: faltan paquetes" "${missing[*]} — corre: sudo apt install -y ${missing[*]}"
    exit 0
fi

note "Nebula: instalando paquetes" "${missing[*]}"
if "${RUN[@]}" DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}" >/dev/null 2>&1; then
    note "Paquetes instalados" "${missing[*]}"
    # Si se instalaron cosas que cambian la sesion (alttab, copyq...), recargar.
    command -v bspc >/dev/null 2>&1 && bspc wm -r >/dev/null 2>&1 || true
else
    warn "Nebula" "fallo la instalacion de: ${missing[*]} (corre 'sudo apt install' a mano)"
fi
