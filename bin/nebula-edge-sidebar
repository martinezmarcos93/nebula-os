#!/usr/bin/env bash
# nebula-edge-sidebar - Abre el sidebar de eww al llevar el puntero al borde
# izquierdo de la pantalla y lo cierra al alejarlo. Es el gesto principal para
# el sidebar; el atajo Super+B sigue funcionando en paralelo.
#
# Usa POLLING de la posicion del puntero (xdotool), NO el `:onhover` de eww:
# aquel modelo (ventana-sensor + hover del widget) entraba en loop abrir/cerrar
# porque el sidebar tapaba al sensor (ver CHANGELOG, commit 18aa8fc).
#
# Una sola instancia por DISPLAY (lock) y termina sola si el servidor X
# desaparece: antes un loop huerfano de una sesion anterior seguia vivo para
# siempre y, como bspwmrc usaba `pgrep -f`, impedia arrancar el de la sesion
# nueva (gesto de borde muerto tras volver a entrar).
#
# Uso: nebula-edge-sidebar [--help]   (corre en loop; lo lanza bspwmrc)
set -uo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    sed -n '2,15p' "$0"
    exit 0
fi

WIDTH="${NEBULA_SIDEBAR_WIDTH:-260}"     # ancho del sidebar (px) -> zona muerta
# Zona caliente ancha (no 1 px): con 1 px el puntero tenia que quedar clavado
# en la primera columna y casi nunca disparaba. 6 px se alcanza con solo
# empujar el raton contra el borde. Subilo mas si lo queres aun mas sensible.
EDGE="${NEBULA_SIDEBAR_EDGE:-6}"         # px desde el borde que disparan apertura
# Poll rapido: a 0.15 s el gesto se sentia con retardo. 0.05 s = ~20 lecturas/s,
# xdotool getmouselocation es barato (no mide nada mas).
INTERVAL="${NEBULA_SIDEBAR_POLL:-0.05}"  # segundos entre lecturas del puntero

for c in xdotool eww nebula-sidebar; do
    command -v "$c" >/dev/null 2>&1 || { echo "nebula-edge-sidebar: falta '$c'" >&2; exit 1; }
done

GAME_STATE="${XDG_CACHE_HOME:-$HOME/.cache}/nebula/gamemode"

[[ -n "${DISPLAY:-}" ]] || { echo "nebula-edge-sidebar: sin DISPLAY" >&2; exit 1; }
LOCK_DIR="${XDG_RUNTIME_DIR:-/tmp/nebula-$(id -u)}/nebula"
mkdir -p "$LOCK_DIR" || exit 1
exec 8> "$LOCK_DIR/edge-sidebar.${DISPLAY//[^A-Za-z0-9_.-]/_}.lock"
flock -n 8 || exit 0          # ya hay uno para este DISPLAY (p. ej. `bspc wm -r`)

# Lecturas fallidas seguidas antes de concluir que X murio (~2 s).
MAX_FAILS="${NEBULA_SIDEBAR_MAX_FAILS:-40}"
fails=0

# Estado que creemos tener. Si el usuario abre/cierra con Super+B se puede
# desincronizar un tick, pero se auto-corrige al mover el puntero.
open=0

while :; do
    sleep "$INTERVAL"

    x="$(xdotool getmouselocation --shell 2>/dev/null | sed -n 's/^X=//p')"
    if ! [[ "$x" =~ ^[0-9]+$ ]]; then
        (( ++fails >= MAX_FAILS )) && exit 0      # X cerro: no quedar huerfano
        continue
    fi
    fails=0

    if (( x <= EDGE )); then
        # Modo Juego: el panel esta apagado a proposito; un juego en ventana
        # (no fullscreen) no debe poder abrir el sidebar rozando el borde.
        [[ -e "$GAME_STATE" ]] && continue
        # No abrir por encima de una ventana en fullscreen (juego / video).
        if command -v bspc >/dev/null 2>&1 \
           && [[ -n "$(bspc query -N -n .fullscreen.window 2>/dev/null)" ]]; then
            continue
        fi
        if (( open == 0 )); then
            nebula-sidebar open >/dev/null 2>&1 && open=1
        fi
    elif (( x > WIDTH )); then
        if (( open == 1 )); then
            nebula-sidebar close >/dev/null 2>&1 && open=0
        fi
    fi
done
