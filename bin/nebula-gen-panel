#!/usr/bin/env bash
# nebula-gen-panel - Genera el panel y el menu de categorias de Nebula OS a
# partir de dotfiles/nebula/categories.toml (fuente unica de datos).
#
#   nebula-gen-panel            regenera la seccion de categorias de eww.yuck
#   nebula-gen-panel --menu     muestra el menu rofi de categorias/apps y lanza
#
# La lectura/validacion del TOML la hace bin/nebula-categories (lector unico).
set -euo pipefail

case "${1:-}" in
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
esac

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
TOML="${NEBULA_CATEGORIES:-$CFG/nebula/categories.toml}"
[[ -f "$TOML" ]] || { echo "no existe $TOML" >&2; exit 1; }

# Toda la lectura de categories.toml pasa por el lector UNICO
# (bin/nebula-categories, R-201): mismo parser, misma validacion y misma regla
# de "app instalada" (incluida la de Flatpak, R-202) que la extension. Antes
# habia un parser awk propio aca, otro en el test y tomllib en la extension.
# Se busca junto a este script (repo o ~/.local/bin) y si no, en el PATH.
CATS="$(dirname "$(readlink -f "$0")")/nebula-categories"
[[ -x "$CATS" ]] || CATS="$(command -v nebula-categories || true)"
[[ -n "$CATS" ]] || { echo "falta nebula-categories (corre install/50-funciones.sh)" >&2; exit 1; }

do_menu() {
    local rows sel app ex
    rows="$("$CATS" tsv --installed --toml "$TOML")" || exit 1
    [[ -n "$rows" ]] || { echo "categories.toml vacio (o nada instalado)" >&2; exit 1; }
    if ! command -v rofi >/dev/null 2>&1; then
        printf '%s\n' "$rows"
        return 0
    fi
    # `|| true`: si el usuario cancela rofi (Esc) sale != 0 y con `set -e` eso
    # abortaria el script sin llegar al `return 0` de abajo.
    sel="$(printf '%s\n' "$rows" \
        | awk -F'\t' '{printf "%s  -  %s\n",$1,$2}' \
        | rofi -dmenu -i -p 'Categorias' || true)"
    [[ -n "$sel" ]] || return 0
    app="${sel#*  -  }"
    ex="$(printf '%s\n' "$rows" | awk -F'\t' -v a="$app" '$2==a {print $3; exit}')"
    [[ -n "$ex" ]] || { echo "no encontre la app '$app'" >&2; exit 1; }
    setsid -f sh -c "$ex" >/dev/null 2>&1 || sh -c "$ex" &
}

do_gen() {
    local yuck="$CFG/eww/eww.yuck"
    [[ -f "$yuck" ]] || { echo "sin $yuck; nada que regenerar" >&2; return 0; }
    # Los iconos de categoria viven junto al categories.toml desplegado.
    if ! "$CATS" render-yuck "$yuck" --toml "$TOML" --icons-dir "$CFG/nebula/icons"; then
        echo "eww.yuck: no se regenero (ver el error de arriba); el archivo queda como estaba." >&2
        return 1
    fi
    command -v eww >/dev/null 2>&1 && eww -c "$CFG/eww" reload >/dev/null 2>&1 || true
    echo "eww.yuck: seccion de categorias regenerada."
}

case "${1:-gen}" in
    --menu)     do_menu ;;
    gen)        do_gen ;;
    *)          echo "uso: nebula-gen-panel [--menu]" >&2; exit 2 ;;
esac
