#!/usr/bin/env bash
# dotfiles/bspwm/bspwmrc - Nebula OS
# Paleta "Cosmic Dark" (sync con dotfiles/nebula/colors.sh).
# bspwm lo ejecuta en cada arranque de sesion; debe ser idempotente.

_run() {
    local name="$1"
    pgrep -x "$name" >/dev/null 2>&1 && return 0
    "$@" &
}

# --- Puntero del mouse --------------------------------------------------
# Sin esto, el cursor del root queda INVISIBLE hasta que el puntero entra
# a una ventana cliente (bug clasico de WMs minimalistas: nadie define el
# cursor del root). Primero cargamos ~/.Xresources (trae Xcursor.theme /
# Xcursor.size que escribe install/40-tema.sh) y despues fijamos la flecha
# estandar, ya resuelta contra ese tema para clientes no-GTK (rofi, root,
# ventanas X puras). Las apps GTK toman el cursor de xsettingsd aparte.
if command -v xrdb >/dev/null 2>&1 && [[ -f "$HOME/.Xresources" ]]; then
    xrdb -merge "$HOME/.Xresources"
fi
command -v xsetroot >/dev/null 2>&1 && xsetroot -cursor_name left_ptr

# --- Teclado ----------------------------------------------------------
# Un gestor de display (GDM) ya aplica el layout del sistema, pero los caminos
# `startx` y `ly` (NEBULA_LOGIN) no dejan nada que lo haga: sin esto el teclado
# se queda en el default de X (us) y se pierden la ñ, los acentos y AltGr.
# Fuente de verdad: /etc/default/keyboard, que escribe el instalador de Ubuntu
# / `dpkg-reconfigure keyboard-configuration`. Fallback a 'latam' si no existe.
# Idempotente: re-aplicarlo en cada `bspc wm -r` no molesta.
if command -v setxkbmap >/dev/null 2>&1; then
    _kbd_layout="latam"
    [[ -r /etc/default/keyboard ]] && . /etc/default/keyboard
    _kbd_args=(-layout "${XKBLAYOUT:-$_kbd_layout}")
    [[ -n "${XKBMODEL:-}"   ]] && _kbd_args+=(-model   "$XKBMODEL")
    [[ -n "${XKBVARIANT:-}" ]] && _kbd_args+=(-variant "$XKBVARIANT")
    [[ -n "${XKBOPTIONS:-}" ]] && _kbd_args+=(-option "" -option "$XKBOPTIONS")
    setxkbmap "${_kbd_args[@]}" 2>/dev/null || true
    unset _kbd_layout _kbd_args
fi

# --- Autostart ------------------------------------------------------------
pgrep -x sxhkd >/dev/null 2>&1 || sxhkd &
_run picom --config "$HOME/.config/picom/picom.conf"
_run dunst
_run lxpolkit
_run nm-applet
_run xsettingsd
# Alt+Tab visual entre ventanas (estilo escritorio clasico): mantener Alt,
# Tab cicla, soltar Alt elige. Alt+Shift+Tab va hacia atras. alttab corre
# residente y agarra el atajo por su cuenta (sxhkd no toca Alt+Tab). `-w 1`
# es el modo de activacion compatible con bspwm.
_run alttab -w 1
# Portapapeles con historial persistente. `copyq` sin argumentos y sin server
# vivo arranca SOLO el server (sin ventana). El historial se guarda a disco,
# asi que sobrevive al cierre de la app que copio. No necesita systray (en
# copyq 7.x la falta de bandeja no es un problema). Se consulta con Super + V
# (ver sxhkdrc). `_run` evita un segundo server en cada `bspc wm -r`.
_run copyq

# Bloqueo automatico: al suspender y por inactividad. `xset s 300` arma el
# "screensaver" de X a los 5 min sin actividad; xss-lock lo escucha (igual que
# la senal de suspension) y corre el mismo i3lock que Super+Shift+X y el menu
# de energia (nebula-powermenu). Sin xss-lock no tiene sentido el timer solo.
if command -v xss-lock >/dev/null 2>&1; then
    command -v xset >/dev/null 2>&1 && xset s 300 5
    _run xss-lock -- i3lock -n -c 000000
fi

# Fondo: negro puro por defecto; feh si hay wallpaper.
_wall="$HOME/.config/nebula/wallpapers/current"
if [[ -f "$_wall" ]]; then
    feh --no-fehbg --bg-fill "$_wall"
else
    command -v xsetroot >/dev/null 2>&1 && xsetroot -solid '#000000'
fi

# Panel: se arranca SOLO el daemon de eww (sin abrir ninguna ventana). El
# sidebar es una unica ventana "nebula-sidebar" que el usuario abre/cierra
# con Super + b (`eww open --toggle nebula-sidebar`, ver sxhkdrc). Tener el
# daemon ya vivo hace que el primer Super+b responda al instante.
# `pidof -q` evita levantar un segundo daemon en cada `bspc wm -r`.
if [[ "${NEBULA_PANEL:-eww}" == "eww" ]] && command -v eww >/dev/null 2>&1; then
    pidof -q eww || eww -c "$HOME/.config/eww" daemon &
elif [[ -x "$HOME/.config/polybar/launch.sh" ]]; then
    "$HOME/.config/polybar/launch.sh" &
fi

# --- Escritorios (uno por categoria) -----------------------------------
bspc monitor -d I II III IV V VI

# --- Estetica ---------------------------------------------------------
bspc config border_width          2
bspc config window_gap            10
bspc config split_ratio           0.52
bspc config borderless_monocle    true
bspc config gapless_monocle       true
# Foco DELIBERADO: no cambia solo por pasar el mouse por encima. Necesario
# para que los widgets/zonas interactivas (sidebar, HUD) no roben el foco de
# las ventanas al moverse el puntero. Se cambia con clic o atajos de teclado.
bspc config focus_follows_pointer false
bspc config pointer_follows_focus false

bspc config normal_border_color   "#1f2937"
bspc config focused_border_color  "#7c3aed"
bspc config presel_feedback_color "#22d3ee"

# --- Reglas ---------------------------------------------------------
# MODO FLOTANTE: toda ventana abre suelta (no tileada). Se mueve y redimensiona
# con Super+arrastre o con el raton en los bordes; Alt+Tab (alttab) cambia
# entre ellas. Para tilear una ventana puntualmente: Super + T. Quitar esta
# regla vuelve al tiling automatico. Por eso las reglas `state=floating` por
# app (Pavucontrol, Nsxiv, mpv) ya no hacen falta: quedan cubiertas por el '*'.
bspc rule -a '*'             state=floating
# Nota: sin reglas para Lutris/Heroic/RetroArch - se descartaron del alcance
# (solo Steam, ver dotfiles/nebula/categories.toml y memoria de proyecto).
bspc rule -a Steam           desktop='^3' follow=on
bspc rule -a steam_app_*     state=fullscreen
bspc rule -a "*:Toolkit:Picture-in-Picture" state=floating sticky=on

# --- Autostart de sesion (una vez por login, NO en cada `bspc wm -r`) ---
# Toda la logica de "solo una vez" vive en autostart.sh: este bloque se
# re-ejecuta en cada recarga del WM, pero el script se auto-descarta si ya
# corrio en esta sesion. Ver dotfiles/bspwm/autostart.sh.
[[ -x "$HOME/.config/bspwm/autostart.sh" ]] && "$HOME/.config/bspwm/autostart.sh" &
