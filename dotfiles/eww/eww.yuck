;; dotfiles/eww/eww.yuck - Nebula OS  "Cosmic Dark"
;; Dos ventanas:
;;   nebula-bar     barra de estado superior, siempre visible (la abre bspwmrc)
;;   nebula-sidebar panel lateral izquierdo (260 px) con las categorias/apps
;;
;; La lista de categorias/apps del sidebar la regenera `nebula-gen-panel` a
;; partir de dotfiles/nebula/categories.toml. NO edites a mano el bloque entre
;; los marcadores autogen de mas abajo.
;;
;; UX del sidebar: una sola ventana, sin :onhover de eww. Se abre llevando el
;; puntero al borde izquierdo (bin/nebula-edge-sidebar, polling del puntero) o
;; con Super + B; el boton "‹" del header la cierra. El daemon de eww lo
;; arranca bspwmrc al iniciar sesion.

(defpoll TIME :interval "10s" :initial "--:--" "date '+%H:%M'")
(defpoll DATE :interval "60s" :initial ""      "date '+%a %d %b'")
;; CPU: diferencia entre dos lecturas de /proc/stat (los contadores son
;; acumulados desde el arranque: una sola lectura da el promedio historico).
(defpoll CPU  :interval "2s"  :initial "0"
  "{ head -n1 /proc/stat; sleep 0.5; head -n1 /proc/stat; } | awk '{t=0; for (i=2;i<=NF;i++) t+=$i; id=$5+$6} NR==1 {t1=t; i1=id} NR==2 {dt=t-t1; printf \"%d\", (dt>0 ? (dt-(id-i1))*100/dt : 0)}'")
(defpoll MEM  :interval "2s"  :initial "0"
  "free | awk '/Mem:/ {printf \"%d\", $3/$2*100}'")
;; GPU: una sola lectura de nvidia-smi cada 5 s compartida por los 3 polls
;; (bin/nebula-gpu-stat, con cache y lock). Vacio sin NVIDIA -> se oculta.
(defpoll GPU  :interval "5s"  :initial ""
  "nebula-gpu-stat util")
(defpoll VRAM :interval "5s"  :initial ""
  "nebula-gpu-stat vram")
(defpoll VRAM_PCT :interval "5s"  :initial ""
  "nebula-gpu-stat vram_pct")
(defpoll TEMP :interval "5s"  :initial ""
  "sensors 2>/dev/null | awk '/Package id 0/ {print $4; exit}'")

;; Grabacion de pantalla en curso (bin/nebula-screenrecord): indicador REC.
(defpoll REC :interval "1s" :initial "off" "nebula-screenrecord status")

;; Ventanas del escritorio enfocado (incluye las minimizadas), para el taskbar
;; de nebula-bar. bin/nebula-taskbar re-emite el JSON ante cada cambio de bspwm.
(deflisten TASKWINS :initial "[]" "nebula-taskbar")

;; --- Estado de la barra lateral (lo maneja bin/nebula-sidebar) ----------
;; SIDEBAR_REVEAL: deslizamiento (U-01). CAT_OPEN: submenu abierto (U-02).
;; QUERY: texto del buscador (U-03). RESULTS: sus coincidencias, JSON
;; [{"label","cmd"}] calculado por `nebula-categories search`.
(defvar SIDEBAR_REVEAL false)
(defvar CAT_OPEN "")
(defvar QUERY "")
(defvar RESULTS "[]")

;; Categoria = submenu desplegable (acordeon: una abierta a la vez). El
;; bloque autogen (bin/nebula-categories) pasa sus apps como hijos.
(defwidget catgroup [name slug icon]
  (box :class "catgroup" :orientation "v" :space-evenly false
    (button :class "cat-head ${CAT_OPEN == slug ? 'cat-open' : ''}" :onclick "nebula-sidebar toggle-cat ${slug}"
      (box :orientation "h" :space-evenly false :spacing 6
        (image :path icon :image-width 16 :image-height 16)
        (label :halign "start" :hexpand true :text name)
        (label :class "cat-arrow" :text {CAT_OPEN == slug ? "▾" : "▸"})))
    (revealer :transition "slidedown" :reveal {CAT_OPEN == slug} :duration "180ms"
      (box :class "cat-apps" :orientation "v" :space-evenly false :spacing 2
        (children)))))

;; Solo se generan apps instaladas (bin/nebula-categories); una categoria sin
;; apps no se dibuja. Lanzar una app cierra la barra lateral.
(defwidget launcher [label cmd]
  (button :class "app" :halign "fill" :onclick "${cmd} nebula-sidebar close"
    (label :halign "start" :text label)))

;; Resultado del buscador. Solo se dibujan las coincidencias (RESULTS): un
;; widget por app filtrado con regex en eww tardaba segundos por tecla.
(defwidget result [label cmd]
  (button :class "app result" :halign "fill"
          :onclick "${cmd} nebula-sidebar close"
    (label :halign "start" :text label)))

(defwidget stat-row [icon label value pct]
  (box :class "stat-row" :orientation "v" :space-evenly false :spacing 2
    (box :orientation "h" :space-evenly false :spacing 6
      (image :path icon :image-width 14 :image-height 14)
      (label :class "stat-label" :halign "start" :hexpand true :text label)
      (label :class "stat-value" :halign "end" :text value))
    (progress :class "stat-bar" :value pct :orientation "horizontal")))

(defwidget sidebar-content []
  ;; U-01: el contenido entra y sale deslizandose (bin/nebula-sidebar abre la
  ;; ventana replegada y recien despues la revela).
  (revealer :transition "slideright" :reveal SIDEBAR_REVEAL :duration "200ms"
  (box :class "sidebar" :orientation "v" :space-evenly false :spacing 4 :hexpand true :vexpand true :width 260
    (box :class "sidebar-header" :orientation "h" :space-evenly false :spacing 8
      (image :path "${EWW_CONFIG_DIR}/../nebula/icons/brand-mark.png" :image-width 26 :image-height 26)
      (label :class "brand" :halign "start" :hexpand true :show-truncated false :text "NEBULA")
      (button :class "hide-btn" :onclick "nebula-sidebar close" (label :text "‹")))

    ;; U-03: buscador. Tipear filtra en vivo; Enter lanza la primera
    ;; coincidencia. Sin :value (atarlo a QUERY re-renderiza el campo con
    ;; cada tecla y se pierde lo tipeado).
    ;; SEGURIDAD: eww pega {} CRUDO dentro de `/bin/sh -c` (replace_placeholders,
    ;; sin escapar): tipear `x; comando` lo ejecutaba (verificado). El texto va
    ;; por un heredoc con comillas, que el shell no interpreta; el campo es de
    ;; una linea, asi que no se puede "cerrar" el heredoc desde el texto.
    (input :class "search"
           :onchange "nebula-sidebar query <<'NEBULA_QUERY_EOF'
{}
NEBULA_QUERY_EOF"
           :onaccept "nebula-sidebar launch-first <<'NEBULA_QUERY_EOF'
{}
NEBULA_QUERY_EOF")

    (scroll :vscroll true :hscroll false :vexpand true
      (box :orientation "v" :space-evenly false :spacing 2
        ;; --- nebula:autogen BEGIN (no editar) ---
        (box :orientation "v" :space-evenly false :spacing 2 :visible {QUERY == ""}
          (catgroup :name "Favoritos" :slug "favoritos" :icon "${EWW_CONFIG_DIR}/../nebula/icons/favoritos.png"
            (launcher :label "Terminal" :cmd "alacritty &")
            (launcher :label "Navegador web" :cmd "librewolf &")
            (launcher :label "Firefox" :cmd "firefox &")
            (launcher :label "Archivos" :cmd "nautilus --new-window &")
            (launcher :label "Configuracion del sistema" :cmd "gnome-control-center &"))
          (catgroup :name "Terminales" :slug "terminales" :icon "${EWW_CONFIG_DIR}/../nebula/icons/terminales.png"
            (launcher :label "Alacritty" :cmd "alacritty &")
            (launcher :label "Kitty" :cmd "kitty &")
            (launcher :label "WezTerm" :cmd "wezterm &")
            (launcher :label "GNOME Terminal" :cmd "gnome-terminal &")
            (launcher :label "Tilix" :cmd "tilix &")
            (launcher :label "Konsole" :cmd "konsole &")
            (launcher :label "xterm" :cmd "xterm &"))
          (catgroup :name "Navegadores" :slug "navegadores" :icon "${EWW_CONFIG_DIR}/../nebula/icons/navegadores.png"
            (launcher :label "Firefox" :cmd "firefox &")
            (launcher :label "LibreWolf" :cmd "librewolf &")
            (launcher :label "Google Chrome" :cmd "google-chrome-stable &")
            (launcher :label "Chromium" :cmd "chromium &")
            (launcher :label "Brave" :cmd "brave-browser &")
            (launcher :label "Vivaldi" :cmd "vivaldi-stable &"))
          (catgroup :name "Comunicacion" :slug "comunicacion" :icon "${EWW_CONFIG_DIR}/../nebula/icons/comunicacion.png"
            (launcher :label "Discord" :cmd "flatpak run com.discordapp.Discord &")
            (launcher :label "Thunderbird" :cmd "thunderbird &"))
          (catgroup :name "Desarrollo" :slug "desarrollo" :icon "${EWW_CONFIG_DIR}/../nebula/icons/desarrollo.png"
            (launcher :label "Terminal" :cmd "alacritty &")
            (launcher :label "VS Code" :cmd "code &")
            (launcher :label "Editor (nvim)" :cmd "alacritty -e nvim &")
            (launcher :label "Editor de texto (GNOME)" :cmd "gnome-text-editor &")
            (launcher :label "Git TUI" :cmd "alacritty -e lazygit &")
            (launcher :label "Docker TUI" :cmd "alacritty -e lazydocker &")
            (launcher :label "Base de datos" :cmd "dbeaver &"))
          (catgroup :name "Multimedia" :slug "multimedia" :icon "${EWW_CONFIG_DIR}/../nebula/icons/multimedia.png"
            (launcher :label "Video (mpv)" :cmd "mpv --player-operation-mode=pseudo-gui &")
            (launcher :label "VLC" :cmd "vlc &")
            (launcher :label "Videos (Totem)" :cmd "totem &")
            (launcher :label "Musica (cmus)" :cmd "alacritty -e cmus &")
            (launcher :label "Rhythmbox" :cmd "rhythmbox &")
            (launcher :label "Spotify" :cmd "spotify &")
            (launcher :label "OBS Studio" :cmd "obs &")
            (launcher :label "Control de audio" :cmd "pavucontrol &")
            (launcher :label "Perfiles de streaming" :cmd "nebula-streaming-profile &"))
          (catgroup :name "Graficos" :slug "graficos" :icon "${EWW_CONFIG_DIR}/../nebula/icons/graficos.png"
            (launcher :label "GIMP" :cmd "gimp &")
            (launcher :label "Krita" :cmd "krita &")
            (launcher :label "Inkscape" :cmd "inkscape &")
            (launcher :label "Darktable" :cmd "darktable &")
            (launcher :label "Blender" :cmd "blender &")
            (launcher :label "Visor de imagenes" :cmd "nsxiv -t . &")
            (launcher :label "Shotwell" :cmd "shotwell &"))
          (catgroup :name "Ofimatica" :slug "ofimatica" :icon "${EWW_CONFIG_DIR}/../nebula/icons/ofimatica.png"
            (launcher :label "LibreOffice" :cmd "libreoffice &")
            (launcher :label "Writer" :cmd "libreoffice --writer &")
            (launcher :label "Calc" :cmd "libreoffice --calc &")
            (launcher :label "Impress" :cmd "libreoffice --impress &")
            (launcher :label "Visor de PDF" :cmd "evince &")
            (launcher :label "Notas (Obsidian)" :cmd "obsidian &")
            (launcher :label "ONLYOFFICE" :cmd "flatpak run org.onlyoffice.desktopeditors &"))
          (catgroup :name "IA Local" :slug "ia-local" :icon "${EWW_CONFIG_DIR}/../nebula/icons/ia-local.png"
            (launcher :label "Iniciar Ollama" :cmd "nebula-ai-chat --serve &")
            (launcher :label "Chat con modelo" :cmd "nebula-ai-chat &")
            (launcher :label "Descargar modelo" :cmd "nebula-ai-chat --pull &")
            (launcher :label "Estado GPU" :cmd "alacritty -e watch -n2 nvidia-smi &"))
          (catgroup :name "Gaming" :slug "gaming" :icon "${EWW_CONFIG_DIR}/../nebula/icons/gaming.png"
            (launcher :label "Steam" :cmd "steam &")
            (launcher :label "Lutris" :cmd "flatpak run net.lutris.Lutris &")
            (launcher :label "Heroic" :cmd "flatpak run com.heroicgameslauncher.hgl &")
            (launcher :label "RetroArch" :cmd "retroarch &")
            (launcher :label "PrismLauncher" :cmd "prismlauncher &")
            (launcher :label "Modo Juego" :cmd "nebula-game-mode &"))
          (catgroup :name "Sistema" :slug "sistema" :icon "${EWW_CONFIG_DIR}/../nebula/icons/sistema.png"
            (launcher :label "Archivos" :cmd "nautilus --new-window &")
            (launcher :label "Archivos (Thunar)" :cmd "thunar &")
            (launcher :label "Monitor de recursos" :cmd "alacritty -e btop &")
            (launcher :label "Monitor del sistema" :cmd "gnome-system-monitor &")
            (launcher :label "Discos" :cmd "gnome-disks &")
            (launcher :label "Red" :cmd "alacritty -e nmtui &")
            (launcher :label "Captura de pantalla" :cmd "nebula-screenshot region &")
            (launcher :label "Grabacion de pantalla" :cmd "nebula-screenrecord &")
            (launcher :label "Portapapeles" :cmd "copyq toggle &")
            (launcher :label "Configuracion de GPU (NVIDIA)" :cmd "nvidia-settings &")
            (launcher :label "Copias de seguridad (Deja Dup)" :cmd "deja-dup &")
            (launcher :label "Rescatar entorno" :cmd "nebula-rescue &")
            (launcher :label "Papelera" :cmd "nautilus trash:/// &"))
          (catgroup :name "Herramientas" :slug "herramientas" :icon "${EWW_CONFIG_DIR}/../nebula/icons/herramientas.png"
            (launcher :label "Calculadora" :cmd "gnome-calculator &")
            (launcher :label "Calendario" :cmd "gnome-calendar &")
            (launcher :label "Registros del sistema" :cmd "gnome-logs &")
            (launcher :label "Escaner de documentos" :cmd "simple-scan &")
            (launcher :label "Escritorio remoto (Remmina)" :cmd "remmina &")
            (launcher :label "Transmission (BitTorrent)" :cmd "transmission-gtk &")
            (launcher :label "Gestor de archivos comprimidos" :cmd "file-roller &")
            (launcher :label "Editor de particiones" :cmd "gparted &")
            (launcher :label "Uso de disco" :cmd "baobab &")
            (launcher :label "Ajustes avanzados" :cmd "gnome-tweaks &")
            (launcher :label "Editor de dconf" :cmd "dconf-editor &")
            (launcher :label "Contrasenas y claves" :cmd "seahorse &")
            (launcher :label "Copias de seguridad" :cmd "timeshift-gtk &")
            (launcher :label "Tienda de software" :cmd "gnome-software &")
            (launcher :label "Synaptic" :cmd "synaptic-pkexec &"))
          (catgroup :name "Configuracion" :slug "configuracion" :icon "${EWW_CONFIG_DIR}/../nebula/icons/configuracion.png"
            (launcher :label "Controladores adicionales" :cmd "software-properties-gtk --open-tab=4 &")
            (launcher :label "Configuracion de red" :cmd "nm-connection-editor &")
            (launcher :label "CPU-X" :cmd "cpu-x &")
            (launcher :label "Caracteres" :cmd "gnome-characters &")
            (launcher :label "Relojes" :cmd "gnome-clocks &")
            (launcher :label "Neovim" :cmd "alacritty -e nvim &")
            (launcher :label "Estadisticas de energia" :cmd "gnome-power-statistics &"))
        )
        ;; --- nebula:autogen END ---
        (box :class "results" :orientation "v" :space-evenly false :spacing 2 :visible {QUERY != ""}
          (for r in RESULTS
            (result :label {r.label} :cmd {r.cmd}))
          (label :class "no-results" :halign "start" :visible {RESULTS == "[]"}
                 :text "Sin resultados"))
        ))

    (box :class "stats" :orientation "v" :space-evenly false :spacing 6
      (stat-row :icon "${EWW_CONFIG_DIR}/../nebula/icons/cpu.png" :label "CPU" :value "${CPU}%" :pct {CPU})
      (stat-row :icon "${EWW_CONFIG_DIR}/../nebula/icons/ram.png" :label "RAM" :value "${MEM}%" :pct {MEM})
      ;; GPU/VRAM solo con NVIDIA (sin nvidia-smi el poll queda vacio).
      (box :orientation "v" :space-evenly false :spacing 6 :visible {GPU != ""}
        (stat-row :icon "${EWW_CONFIG_DIR}/../nebula/icons/gpu.png" :label "GPU" :value "${GPU}%" :pct {GPU != "" ? GPU : 0})
        (stat-row :icon "${EWW_CONFIG_DIR}/../nebula/icons/gpu.png" :label "VRAM" :value "${VRAM}MB" :pct {VRAM_PCT != "" ? VRAM_PCT : 0}))
      (label :halign "start" :class "temp-label" :text {TEMP != "" ? "TEMP ${TEMP}" : ""})
      (label :halign "start" :class "clock" :text "${DATE}  ${TIME}")))))

;; UNA sola ventana, sin strut (no empuja las ventanas) y con :wm-ignore
;; (bspwm no la gestiona).
;; Se abre llevando el puntero al borde izquierdo (nebula-edge-sidebar) o con
;; Super + B; el daemon lo arranca bspwmrc sin abrir esta ventana.
;; Sidebar principal: la abre el boton de disparo o Super+B.
(defwindow nebula-sidebar
  :monitor 0
  :geometry (geometry :x "0" :y "0" :width "260px" :height "100%" :anchor "left center")
  :stacking "fg"
  :wm-ignore true
  (sidebar-content))

;; Disparador manual fijo en el borde izquierdo.
(defwindow nebula-trigger
  :monitor 0
  :geometry (geometry :x "0" :y "0" :width "10px" :height "100%" :anchor "left center")
  :stacking "fg"
  :wm-ignore true
  (button :class "trigger-btn" :onclick "nebula-sidebar open" "▸"))


;; --- Barra de estado superior -----------------------------------------
;; Siempre visible (la abre bspwmrc al iniciar sesion). Marca (izq.) · taskbar
;; de ventanas del escritorio enfocado (centro) · reloj-fecha + CPU/RAM/GPU/temp
;; (der.). :reserve -> reserva la franja superior, las ventanas no la
;; tapan. Sin glyphs de Nerd Font (la UI usa Inter): texto plano.

;; Taskbar: un boton por ventana del escritorio enfocado (TASKWINS, via
;; bin/nebula-taskbar). Clic = restaurar si esta minimizada (hidden=off) y
;; enfocar. La enfocada va resaltada; las minimizadas, en gris e italica con
;; un punto delante. Asi se minimiza/restaura "con normalidad", con el mouse.
(defwidget taskbar []
  (box :class "taskbar" :orientation "h" :halign "center" :space-evenly false :spacing 4
    (for w in TASKWINS
      (button :class "task ${w.focused ? "task-active" : ""} ${w.hidden ? "task-hidden" : ""}"
              :onclick "bspc node ${w.id} -g hidden=off -f"
        (label :text "${w.hidden ? "◦ " : ""}${w.label}" :limit-width 24)))))

(defwidget bar-content []
  (centerbox :class "bar" :orientation "h"
    (box :class "bar-left" :halign "start" :space-evenly false :spacing 8
      (image :path "${EWW_CONFIG_DIR}/../nebula/icons/brand-mark.png"
             :image-width 15 :image-height 15)
      (label :class "bar-brand" :text "NEBULA"))
    (box :class "bar-center" :halign "center" :hexpand true
      (taskbar))
    (box :class "bar-right" :halign "end" :space-evenly false :spacing 14
      (button :class "bar-rec" :visible {REC == "rec"} :onclick "nebula-screenrecord stop"
        (label :text "● REC"))
      (label :class "bar-clock" :text "${DATE}   ${TIME}")
      (label :class "bar-stat" :text "CPU ${CPU}%")
      (label :class "bar-stat" :text "RAM ${MEM}%")
      (label :class "bar-stat" :text {GPU  != "" ? "GPU ${GPU}%"   : ""})
      (label :class "bar-stat" :text {TEMP != "" ? "TEMP ${TEMP}"  : ""}))))

(defwindow nebula-bar
  :monitor 0
  :geometry (geometry :x "0" :y "0" :width "100%" :height "26px" :anchor "top center")
  :stacking "fg"
  ;; X11 (bspwm): :reserve publica _NET_WM_STRUT_PARTIAL y bspwm deja libre
  ;; la franja superior. :exclusive/:focusable son SOLO de Wayland: en X11 se
  ;; ignoraban y la barra no reservaba nada (medido con xprop: strut 0).
  :windowtype "dock"
  :reserve (struts :side "top" :distance "26px")
  (bar-content))
