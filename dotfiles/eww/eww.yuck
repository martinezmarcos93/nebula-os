    (box :class "stats" :orientation "v" :space-evenly false :spacing 6
      (stat-row :icon "${EWW_CONFIG_DIR}/../nebula/icons/cpu.png" :label "CPU" :value "${CPU}%" :pct {CPU})
      (stat-row :icon "${EWW_CONFIG_DIR}/../nebula/icons/ram.png" :label "RAM" :value "${MEM}%" :pct {MEM})
      ;; GPU/VRAM solo con NVIDIA (sin nvidia-smi el poll queda vacio).
      (box :orientation "v" :space-evenly false :spacing 6 :visible {GPU != ""}
        (stat-row :icon "${EWW_CONFIG_DIR}/../nebula/icons/gpu.png" :label "GPU" :value "${GPU}%" :pct {GPU != "" ? GPU : 0})
        (stat-row :icon "${EWW_CONFIG_DIR}/../nebula/icons/gpu.png" :label "VRAM" :value "${VRAM}MB" :pct {VRAM_PCT != "" ? VRAM_PCT : 0}))
