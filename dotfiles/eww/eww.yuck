;; dotfiles/eww/eww.yuck - Nebula OS  "Cosmic Dark"
;; Dos ventanas:
;;   nebula-bar     barra de estado superior, siempre visible (la abre bspwmrc)
;;   nebula-sidebar panel lateral izquierdo (260 px) con las categorias/apps
;;
;; La lista de categorias/apps del sidebar la regenera `nebula-gen-panel` a
;; partir de dotfiles/nebula/categories.toml. NO edites a mano el bloque entre
;; los marcadores autogen de mas abajo.
;;
;; UX del sidebar: una sola ventana, sin :onhover de eww. Se abre llevando el
;; puntero al borde izquierdo (bin/nebula-edge-sidebar, polling del puntero) o
;; con Super + B; el boton "‹" del header la cierra. El daemon de eww lo
;; arranca bspwmrc al iniciar sesion.

(defpoll TIME :interval "10s" :initial "--:--" "date '+%H:%M'")
(defpoll DATE :interval "60s" :initial ""      "date '+%a %d %b'")
(defpoll CPU  :interval "2s"  :initial "0"
  "grep 'cpu ' /proc/stat | awk '{u=($2+$4)*100/($2+$4+$5)} END {printf \"%d\", u}'")
(defpoll MEM  :interval "2s"  :initial "0"
  "free | awk '/Mem:/ {printf \"%d\", $3/$2*100}'")
(defpoll GPU  :interval "5s"  :initial "0"
  "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | head -n1")
(defpoll VRAM :interval "5s"  :initial "0"
  "nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null | head -n1")
(defpoll VRAM_PCT :interval "5s"  :initial "0"
  "nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null | head -n1 | awk -F', *' '{ if ($2>0) printf \"%d\", ($1/$2)*100; else print 0 }'")
(defpoll TEMP :interval "5s"  :initial ""
  "sensors 2>/dev/null | awk '/Package id 0/ {print $4; exit}'")

(defwidget cat [name]
  (label :class "cat-title" :halign "start" :text name))

(defwidget cat-icon [name icon]
  (box :class "cat-title-icon" :orientation "h" :space-evenly false :spacing 6
    (image :path icon :image-width 16 :image-height 16 :preserve-aspect-ratio true)
    (label :halign "start" :text name)))

;; Solo se generan `launcher` para apps instaladas (nebula-gen-panel filtra por
;; `command -v`); las ausentes no se listan y una categoria sin apps no se dibuja.
(defwidget launcher [label cmd]
  (button :class "app" :halign "fill" :onclick cmd
    (label :halign "start" :text label)))

(defwidget stat-row [icon label value pct]
  (box :class "stat-row" :orientation "v" :space-evenly false :spacing 2
    (box :orientation "h" :space-evenly false :spacing 6
      (image :path icon :image-width 14 :image-height 14 :preserve-aspect-ratio true)
      (label :class "stat-label" :halign "start" :hexpand true :text label)
      (label :class "stat-value" :halign "end" :text value))
    (progress :class "stat-bar" :value pct :orientation "horizontal")))

(defwidget sidebar-content []
  (box :class "sidebar" :orientation "v" :space-evenly false :spacing 4 :hexpand true :vexpand true
    (box :class "sidebar-header" :orientation "h" :space-evenly false :spacing 8
      (image :path "${EWW_CONFIG_DIR}/../nebula/icons/brand-mark.png" :image-width 26 :image-height 26 :preserve-aspect-ratio true)
      (label :class "brand" :halign "start" :hexpand true :text "NEBULA")
      (button :class "hide-btn" :onclick "eww close nebula-sidebar" (label :text "‹")))

    (scroll :vscroll true :hscroll false :vexpand true
      (box :orientation "v" :space-evenly false :spacing 2
        ;; --- nebula:autogen BEGIN (no editar) ---
        (cat-icon :name "Navegadores" :icon "${EWW_CONFIG_DIR}/../nebula/icons/navegadores.png")
        (launcher :label "Firefox" :cmd "firefox &")
        (launcher :label "Google Chrome" :cmd "google-chrome-stable &")
        (launcher :label "Chromium" :cmd "chromium &")
        (launcher :label "Brave" :cmd "brave-browser &")
        (launcher :label "Vivaldi" :cmd "vivaldi-stable &")
        (cat-icon :name "Desarrollo" :icon "${EWW_CONFIG_DIR}/../nebula/icons/desarrollo.png")
        (launcher :label "Terminal" :cmd "alacritty &")
        (launcher :label "VS Code" :cmd "code &")
        (launcher :label "Editor (nvim)" :cmd "alacritty -e nvim &")
        (launcher :label "Git TUI" :cmd "alacritty -e lazygit &")
        (launcher :label "Docker TUI" :cmd "alacritty -e lazydocker &")
        (launcher :label "Base de datos" :cmd "dbeaver &")
        (cat-icon :name "Ofimatica" :icon "${EWW_CONFIG_DIR}/../nebula/icons/ofimatica.png")
        (launcher :label "LibreOffice" :cmd "libreoffice &")
        (launcher :label "Writer" :cmd "libreoffice --writer &")
        (launcher :label "Calc" :cmd "libreoffice --calc &")
        (launcher :label "Impress" :cmd "libreoffice --impress &")
        (launcher :label "Visor de PDF" :cmd "evince &")
        (launcher :label "Notas (Obsidian)" :cmd "obsidian &")
        (cat-icon :name "Graficos" :icon "${EWW_CONFIG_DIR}/../nebula/icons/graficos.png")
        (launcher :label "GIMP" :cmd "gimp &")
        (launcher :label "Krita" :cmd "krita &")
        (launcher :label "Inkscape" :cmd "inkscape &")
        (launcher :label "Darktable" :cmd "darktable &")
        (launcher :label "Blender" :cmd "blender &")
        (launcher :label "Visor de imagenes" :cmd "nsxiv -t . &")
        (cat-icon :name "Multimedia" :icon "${EWW_CONFIG_DIR}/../nebula/icons/multimedia.png")
        (launcher :label "Video (mpv)" :cmd "mpv --player-operation-mode=pseudo-gui &")
        (launcher :label "VLC" :cmd "vlc &")
        (launcher :label "Musica (cmus)" :cmd "alacritty -e cmus &")
        (launcher :label "Spotify" :cmd "spotify &")
        (launcher :label "OBS Studio" :cmd "obs &")
        (launcher :label "Control de audio" :cmd "pavucontrol &")
        (launcher :label "Perfiles de streaming" :cmd "nebula-streaming-profile &")
        (cat-icon :name "Juegos" :icon "${EWW_CONFIG_DIR}/../nebula/icons/juegos.png")
        (launcher :label "Steam" :cmd "steam &")
        (launcher :label "Lutris" :cmd "lutris &")
        (launcher :label "Heroic" :cmd "heroic &")
        (launcher :label "Modo Juego" :cmd "nebula-game-mode &")
        (cat-icon :name "Sistema" :icon "${EWW_CONFIG_DIR}/../nebula/icons/sistema.png")
        (launcher :label "Archivos" :cmd "nautilus --new-window &")
        (launcher :label "Monitor de recursos" :cmd "alacritty -e btop &")
        (launcher :label "Discos" :cmd "gnome-disks &")
        (launcher :label "Red" :cmd "alacritty -e nmtui &")
        (launcher :label "Captura de pantalla" :cmd "nebula-screenshot region &")
        (launcher :label "Rescatar entorno" :cmd "nebula-rescue &")
        (launcher :label "Energia (bloquear / salir)" :cmd "nebula-powermenu &")
        (cat-icon :name "IA Local" :icon "${EWW_CONFIG_DIR}/../nebula/icons/ia-local.png")
        (launcher :label "Iniciar Ollama" :cmd "nebula-ai-chat --serve &")
        (launcher :label "Chat con modelo" :cmd "nebula-ai-chat &")
        (launcher :label "Descargar modelo" :cmd "nebula-ai-chat --pull &")
        (launcher :label "Estado GPU" :cmd "alacritty -e watch -n2 nvidia-smi &")
        ;; --- nebula:autogen END ---
        ))

    (box :class "stats" :orientation "v" :space-evenly false :spacing 6
      (stat-row :icon "${EWW_CONFIG_DIR}/../nebula/icons/cpu.png" :label "CPU" :value "${CPU}%" :pct {CPU})
      (stat-row :icon "${EWW_CONFIG_DIR}/../nebula/icons/ram.png" :label "RAM" :value "${MEM}%" :pct {MEM})
      (stat-row :icon "${EWW_CONFIG_DIR}/../nebula/icons/gpu.png" :label "GPU" :value "${GPU}%" :pct {GPU})
      (stat-row :icon "${EWW_CONFIG_DIR}/../nebula/icons/gpu.png" :label "VRAM" :value "${VRAM}MB" :pct {VRAM_PCT})
      (label :halign "start" :class "temp-label" :text {TEMP != "" ? "TEMP ${TEMP}" : ""})
      (label :halign "start" :class "clock" :text "${DATE}  ${TIME}"))))

;; UNA sola ventana. Sin :exclusive (no reserva strut, no empuja las ventanas
;; tiled) y con :wm-ignore (bspwm no la gestiona). :focusable false para que
;; nunca robe el foco del teclado (coherente con focus_follows_pointer false).
;; Se abre llevando el puntero al borde izquierdo (nebula-edge-sidebar) o con
;; Super + B; el daemon lo arranca bspwmrc sin abrir esta ventana.
(defwindow nebula-sidebar
  :monitor 0
  :geometry (geometry :x "0" :y "0" :width "260px" :height "100%" :anchor "left center")
  :stacking "fg"
  :exclusive false
  :focusable false
  :wm-ignore true
  (sidebar-content))

;; --- Barra de estado superior -----------------------------------------
;; Siempre visible (la abre bspwmrc al iniciar sesion). Marca / reloj-fecha /
;; CPU-RAM-GPU-temp. :exclusive true -> reserva la franja superior, las
;; ventanas no la tapan. Sin glyphs de Nerd Font (la UI usa Inter): texto plano.
(defwidget bar-content []
  (centerbox :class "bar" :orientation "h"
    (box :class "bar-left" :halign "start" :space-evenly false :spacing 8
      (image :path "${EWW_CONFIG_DIR}/../nebula/icons/brand-mark.png"
             :image-width 15 :image-height 15 :preserve-aspect-ratio true)
      (label :class "bar-brand" :text "NEBULA"))
    (box :halign "center"
      (label :class "bar-clock" :text "${DATE}   ${TIME}"))
    (box :class "bar-right" :halign "end" :space-evenly false :spacing 14
      (label :class "bar-stat" :text "CPU ${CPU}%")
      (label :class "bar-stat" :text "RAM ${MEM}%")
      (label :class "bar-stat" :text {GPU  != "" ? "GPU ${GPU}%"   : ""})
      (label :class "bar-stat" :text {TEMP != "" ? "TEMP ${TEMP}"  : ""}))))

(defwindow nebula-bar
  :monitor 0
  :geometry (geometry :x "0" :y "0" :width "100%" :height "26px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar-content))
