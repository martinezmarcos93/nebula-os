      (label :halign "start" :class "clock" :text "${DATE}  ${TIME}"))))

;; UNA sola ventana, sin strut (no empuja las ventanas) y con :wm-ignore
;; (bspwm no la gestiona).
;; Se abre llevando el puntero al borde izquierdo (nebula-edge-sidebar) o con
;; Super + B; el daemon lo arranca bspwmrc sin abrir esta ventana.
(defwindow nebula-sidebar
  :monitor 0
  :geometry (geometry :x "0" :y "0" :width "260px" :height "100%" :anchor "left center")
  :stacking "fg"
  ;; Sin :reserve: el sidebar se superpone, no empuja las ventanas.
  ;; (:exclusive/:focusable eran propiedades de Wayland, ignoradas en X11.)
  :wm-ignore true
  (sidebar-content))

;; --- Barra de estado superior -----------------------------------------
;; Siempre visible (la abre bspwmrc al iniciar sesion). Marca (izq.) · taskbar
;; de ventanas del escritorio enfocado (centro) · reloj-fecha + CPU/RAM/GPU/temp
;; (der.). :reserve -> reserva la franja superior, las ventanas no la
;; tapan. Sin glyphs de Nerd Font (la UI usa Inter): texto plano.

;; Taskbar: un boton por ventana del escritorio enfocado (TASKWINS, via
;; bin/nebula-taskbar). Clic = restaurar si esta minimizada (hidden=off) y
;; enfocar. La enfocada va resaltada; las minimizadas, en gris e italica con
;; un punto delante. Asi se minimiza/restaura "con normalidad", con el mouse.
(defwidget taskbar []
  (box :class "taskbar" :orientation "h" :halign "center" :space-evenly false :spacing 4
    (for w in TASKWINS
      (button :class "task ${w.focused ? "task-active" : ""} ${w.hidden ? "task-hidden" : ""}"
              :onclick "bspc node ${w.id} -g hidden=off -f"
        (label :text "${w.hidden ? "◦ " : ""}${w.label}" :limit-width 24)))))

(defwidget bar-content []
  (centerbox :class "bar" :orientation "h"
    (box :class "bar-left" :halign "start" :space-evenly false :spacing 8
      (image :path "${EWW_CONFIG_DIR}/../nebula/icons/brand-mark.png"
             :image-width 15 :image-height 15)
      (label :class "bar-brand" :text "NEBULA"))
    (box :class "bar-center" :halign "center" :hexpand true
      (taskbar))
    (box :class "bar-right" :halign "end" :space-evenly false :spacing 14
      (label :class "bar-clock" :text "${DATE}   ${TIME}")
      (label :class "bar-stat" :text "CPU ${CPU}%")
      (label :class "bar-stat" :text "RAM ${MEM}%")
      (label :class "bar-stat" :text {GPU  != "" ? "GPU ${GPU}%"   : ""})
      (label :class "bar-stat" :text {TEMP != "" ? "TEMP ${TEMP}"  : ""}))))

(defwindow nebula-bar
  :monitor 0
  :geometry (geometry :x "0" :y "0" :width "100%" :height "26px" :anchor "top center")
  :stacking "fg"
  ;; X11 (bspwm): :reserve publica _NET_WM_STRUT_PARTIAL y bspwm deja libre
  ;; la franja superior. :exclusive/:focusable son SOLO de Wayland: en X11 se
  ;; ignoraban y la barra no reservaba nada (medido con xprop: strut 0).
  :windowtype "dock"
  :reserve (struts :side "top" :distance "26px")
  (bar-content))
