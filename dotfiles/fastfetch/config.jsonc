// Nebula OS - fastfetch con el logo ASCII de Nebula (anillo + espiral).
// Se despliega en ~/.config/fastfetch/ junto con nebula.txt.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/nebula.txt",
    "color": {"1": "38;2;168;85;247"},
    "padding": {"top": 0, "left": 1, "right": 3}
  },
  "display": {
    "separator": ": ",
    "color": {"keys": "38;2;232;121;249", "title": "38;2;192;132;252"}
  },
  "modules": [
    "title",
    "separator",
    {"type": "os", "key": "OS", "format": "Nebula OS ({name} {version-id} LTS) {arch}"},
    "kernel",
    "uptime",
    {"type": "packages", "format": "{dpkg} (dpkg), {flatpak-all} (flatpak), {snap} (snap)"},
    "shell",
    {"type": "wm", "key": "WM"},
    "terminal",
    {"type": "cpu", "format": "{name} ({cores-physical}) @ {freq-max}"},
    {"type": "gpu", "format": "{name}"},
    "memory",
    "break",
    "colors"
  ]
}
