# dotfiles/sxhkd/sxhkdrc - Nebula OS
# Recargar en caliente:  pkill -USR1 -x sxhkd   (o Super + Escape)
# Matriz completa: ver docs/DESIGN.md, seccion 14.2

# --- Lanzadores --------------------------------------------------------
super + Return
    alacritty
super + space
    rofi -show drun
super + c
    nebula-gen-panel --menu
super + shift + c
    nebula-gen-panel

# Sidebar de eww: unico mecanismo para abrirlo/cerrarlo. Una sola ventana
# ("nebula-sidebar"), sin hover ni ventana-sensor. El daemon lo arranca
# bspwmrc al iniciar sesion, asi este toggle responde al instante.
super + b
    eww -c "$HOME/.config/eww" open --toggle nebula-sidebar

# Historial del portapapeles (copyq). El server lo arranca bspwmrc al iniciar
# sesion; esto abre/cierra la ventana con buscador. Pegar = Enter sobre un item.
super + v
    copyq toggle

# --- Funciones unicas de Nebula --------------------------------------
super + f
    nebula-focus-mode
super + shift + g
    nebula-game-mode
super + a
    nebula-ai-chat
super + h
    nebula-resource-hud
super + ctrl + r
    nebula-rescue

# --- Ventanas --------------------------------------------------------
# Nebula corre bspwm en MODO FLOTANTE (bspc rule -a '*' state=floating en
# bspwmrc): las ventanas abren sueltas y se mueven/redimensionan con
# Super+arrastre o con el raton en los bordes. Mapa rapido:
#   Mover / redimensionar : Super + arrastre (izq mueve, der esquina)
#   Alt+Tab / Alt+Shift+Tab: cambiar de ventana (alttab, no es un bind de aca)
#   Maximizar             : Super + Shift + F  (fullscreen toggle)
#   Minimizar             : Super + D  ->  restaurar: Super + Shift + D
#   Volver una al tiling  : Super + T

# Cerrar la ventana enfocada (equivalente funcional de Alt+F4)
super + w
    bspc node -c

# Foco direccional entre ventanas (reemplaza al viejo super + h/j/k/l)
super + {Left,Down,Up,Right}
    bspc node -f {west,south,north,east}

# SWAP de posiciones con la ventana vecina. Solo tiene efecto sobre ventanas
# que hayas devuelto al tiling con Super+T; en modo flotante (el normal) las
# ventanas se mueven con Super+arrastre, no con esto.
super + shift + {Left,Down,Up,Right}
    bspc node -s {west,south,north,east} --follow

# Cambio rapido a la ultima ventana enfocada (1 nivel). El selector visual
# completo estilo Alt+Tab lo da alttab (ver bspwmrc).
super + Tab
    bspc node -f last

# Minimizar la ventana enfocada. bspwm no tiene "minimizar" real: se marca
# como hidden (desaparece sin perder estado). Restaurar: Super+Shift+D.
# (Una taskbar visible con las minimizadas llega con la barra de estado.)
super + d
    bspc node -g hidden=on

# Selector rofi de ventanas ocultas -> restaura y enfoca la elegida
super + shift + d
    nebula-window-switcher

# Redimensionar la ventana enfocada (empuja el borde ~32px). Flotante:
# siempre. Tiled: mueve el ratio del split del padre; si en ese eje no hay
# un split ajustable (ventana unica, o borde contra la pantalla) es no-op.
super + ctrl + Right
    bspc node -z right 32 0 || bspc node -z left 32 0
super + ctrl + Left
    bspc node -z right -32 0 || bspc node -z left -32 0
super + ctrl + Down
    bspc node -z bottom 0 32 || bspc node -z top 0 32
super + ctrl + Up
    bspc node -z bottom 0 -32 || bspc node -z top 0 -32

# Maximizar / restaurar la ventana enfocada (fullscreen toggle). Tambien es lo
# que usan juegos, Steam y mpv. ~ alterna contra el estado previo.
super + shift + f
    bspc node -t ~fullscreen

# Layout del desktop: alterna monocle <-> tiled. NO es "minimizar".
super + m
    bspc desktop -l next

# Flotante <-> tiled de la ventana enfocada
super + t
    bspc node -t ~floating

# Ir a (super) / enviar la ventana a (super+shift) el escritorio 1..6
super + {_,shift + }{1-6}
    bspc {desktop -f,node -d} '^{1-6}'

# --- Sesion --------------------------------------------------------
super + shift + r
    bspc wm -r
super + shift + x
    i3lock -n -c 000000
# Menu de energia: bloquear / cerrar sesion (bspc quit) / suspender / reiniciar
# / apagar. Las tres destructivas piden confirmacion. Es la unica via por
# teclado para SALIR de la sesion (bspc quit no tenia atajo).
super + shift + e
    nebula-powermenu
super + Escape
    pkill -USR1 -x sxhkd

# --- Captura de pantalla (bin/nebula-screenshot) -----------------
# Todas guardan en <Imagenes>/Capturas/ Y copian al portapapeles; 'clip' es
# la excepcion (solo portapapeles, sin archivo).
Print
    nebula-screenshot full
shift + Print
    nebula-screenshot region
super + Print
    nebula-screenshot window
super + shift + s
    nebula-screenshot clip

# --- Audio / brillo / media (PipeWire via wpctl) ------------------
XF86Audio{RaiseVolume,LowerVolume}
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%{+,-} -l 1.5
XF86AudioMute
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
XF86Audio{Play,Next,Prev}
    playerctl {play-pause,next,previous}
XF86MonBrightness{Up,Down}
    brightnessctl set 5%{+,-}
